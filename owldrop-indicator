SNI_PATH = "/StatusNotifierItem"
SNI_IFACE = "org.kde.StatusNotifierItem"
MENU_PATH = "/MenuBar"
WATCHER = "org.kde.StatusNotifierWatcher"


class TrayIcon:
    """The panel icon, as a StatusNotifierItem.

    Implemented here rather than through AppIndicator because AppIndicator
    marks its icon menu-only, so a left click can only ever open a GtkMenu.
    This item is not menu-only: the tray sends a left click here as Activate
    (with the pointer's screen position), and shows `menu` on a right click.
    """

    def __init__(self, menu, icon_dir, on_activate, on_secondary):
        self.on_activate = on_activate
        self.on_secondary = on_secondary
        self.icon = "owldrop-indicator-off"
        self.title = "AirDrop"
        self.icon_dir = icon_dir or ""
        self.bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        self.name = f"org.kde.StatusNotifierItem-{os.getpid()}-1"

        # The right-click menu, served over com.canonical.dbusmenu as
        # AppIndicator serves it: the parser follows later changes to `menu`.
        self.menu_server = Dbusmenu.Server.new(MENU_PATH)
        self.menu_server.set_root(DbusmenuGtk3.gtk_parse_menu_structure(menu))

        info = Gio.DBusNodeInfo.new_for_xml(SNI_XML).interfaces[0]
        # register_object_with_closures2 is GLib 2.84's name for it.
        register = (getattr(self.bus, "register_object_with_closures2", None)
                    or self.bus.register_object)
        register(SNI_PATH, info, self._call, self._get, None)
        Gio.bus_own_name_on_connection(self.bus, self.name, Gio.BusNameOwnerFlags.NONE,
                                       None, None)
        # Register with the tray whenever one is running, including one that
        # starts, or restarts, after us.
        Gio.bus_watch_name_on_connection(self.bus, WATCHER, Gio.BusNameWatcherFlags.NONE,
                                         self._watcher_appeared, None)

    def _watcher_appeared(self, bus, name, owner):
        bus.call(WATCHER, "/StatusNotifierWatcher", WATCHER, "RegisterStatusNotifierItem",
                 GLib.Variant("(s)", (self.name,)), None, Gio.DBusCallFlags.NONE, -1,
                 None, self._registered)

    def _registered(self, bus, res):
        try:
            bus.call_finish(res)
        except GLib.Error as e:
            print(f"{APP_ID}: the tray refused the icon: {e.message}", file=sys.stderr)

    def _call(self, bus, sender, path, iface, method, params, invocation):
        if method == "Activate":
            self.on_activate(*params.unpack())
        elif method == "SecondaryActivate":
            self.on_secondary()
        # ContextMenu is only called by trays that cannot show dbusmenu
        # menus themselves; Scroll has nothing to do here.
        invocation.return_value(None)

    def _get(self, bus, sender, path, iface, prop):
        return {
            "Category": GLib.Variant("s", "Communications"),
            "Id": GLib.Variant("s", APP_ID),
            "Title": GLib.Variant("s", self.title),
            "Status": GLib.Variant("s", "Active"),
            "WindowId": GLib.Variant("i", 0),
            "IconName": GLib.Variant("s", self.icon),
            "IconThemePath": GLib.Variant("s", self.icon_dir),
            "OverlayIconName": GLib.Variant("s", ""),
            "AttentionIconName": GLib.Variant("s", ""),
            "ToolTip": GLib.Variant("(sa(iiay)ss)", (self.icon, [], self.title, "")),
            "ItemIsMenu": GLib.Variant("b", False),
            "Menu": GLib.Variant("o", MENU_PATH),
        }.get(prop)

    def set(self, icon, title):
        if icon != self.icon:
            self.icon = icon
            self._emit("NewIcon")
        if title != self.title:
            self.title = title
            self._emit("NewTitle")
            self._emit("NewToolTip")

    def _emit(self, signal_name):
        try:
            self.bus.emit_signal(None, SNI_PATH, SNI_IFACE, signal_name, None)
        except GLib.Error:
            pass


class Popup:
    """The left-click drop-down.

    A window of our own rather than a GtkMenu, because an open GtkMenu never
    grows: rows added while it is open, as nearby devices are found, leave it
    the height it opened with, scrolling. This window grows with its content,
    and keeps its edge against the panel while it does.
    """

    def __init__(self, ind):
        self.ind = ind
        self.anchor = None          # the click's screen position
        self.seat = None            # held while open on X11
        self.place_id = 0
        self.rows = {}              # mac -> widgets of that device's row
        display = Gdk.Display.get_default()
        # A popup window and a pointer grab place it under the icon and close
        # it on an outside click, as a menu does. Wayland allows neither to a
        # plain client, so there it is a small undecorated window that closes
        # when it loses focus.
        self.x11 = not display.get_name().startswith("wayland")
        if self.x11:
            w = self.win = Gtk.Window(type=Gtk.WindowType.POPUP)
            w.set_type_hint(Gdk.WindowTypeHint.DROPDOWN_MENU)
            w.connect("button-press-event", self._outside_click)
        else:
            w = self.win = Gtk.Window(type=Gtk.WindowType.TOPLEVEL)
            w.set_decorated(False)
            w.set_skip_taskbar_hint(True)
            w.set_skip_pager_hint(True)
            w.set_keep_above(True)
            w.set_position(Gtk.WindowPosition.MOUSE)
            w.connect("focus-out-event", lambda *_: self.close())
        w.set_resizable(False)
        w.get_style_context().add_class("popup")
        w.get_style_context().add_class("menu")
        w.connect("key-press-event", self._key)
        w.connect("size-allocate", self._resized)
        self._build()

    # --------------------------------------------------------------- widgets

    def _build(self):
        ind = self.ind
        frame = Gtk.Frame()
        frame.set_shadow_type(Gtk.ShadowType.OUT)
        self.win.add(frame)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        box.set_border_width(12)
        box.set_size_request(340, -1)
        frame.add(box)

        top = Gtk.Box(spacing=12)
        title = Gtk.Label(xalign=0)
        title.set_markup("<b>AirDrop</b>")
        top.pack_start(title, True, True, 0)
        self.switch = Gtk.Switch(valign=Gtk.Align.CENTER)
        self.switch.connect("notify::active", self._switched)
        top.pack_end(self.switch, False, False, 0)
        box.add(top)

        self.head = Gtk.Label(xalign=0, wrap=True, max_width_chars=40)
        box.add(self.head)
        self.detail = Gtk.Label(xalign=0, wrap=True, max_width_chars=40)
        self.detail.get_style_context().add_class("dim-label")
        box.add(self.detail)

        def segmented(caption, choices, handler):
            row = Gtk.Box(spacing=8)
            lab = Gtk.Label(label=caption, xalign=0)
            row.pack_start(lab, True, True, 0)
            group = Gtk.Box()
            group.get_style_context().add_class("linked")
            buttons, first = {}, None
            for key, text in choices:
                b = Gtk.RadioButton.new_with_label_from_widget(first, text)
                b.set_mode(False)       # drawn as a button, not a radio dot
                b.connect("toggled", handler, key)
                group.add(b)
                buttons[key] = b
                first = first or b
            row.pack_end(group, False, False, 0)
            box.add(row)
            return row, buttons

        self.dur_row, self.dur_buttons = segmented(
            "Visible for", [(a, DURATION_SHORT[a]) for a, _ in DURATIONS], ind.on_duration)
        self.vis_row, self.vis_buttons = segmented(
            "Who can send", [("everyone", "Everyone"), ("contacts", "Contacts")],
            ind.on_visibility)

        box.add(Gtk.Separator())
        send = Gtk.Label(xalign=0)
        send.set_markup("<b>Send to</b>")
        box.add(send)
        self.hint = Gtk.Label(xalign=0, wrap=True, max_width_chars=40)
        self.hint.get_style_context().add_class("dim-label")
        box.add(self.hint)
        self.list = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        box.add(self.list)
        # Opt-in, as in omdrop: asking a name connects to each device and
        # briefly announces this Apple ID over Bluetooth.
        self.lookup = Gtk.Button(label="Look up device names", halign=Gtk.Align.START)
        self.lookup.set_relief(Gtk.ReliefStyle.NONE)
        self.lookup.connect("clicked", ind.on_lookup)
        box.add(self.lookup)

        box.add(Gtk.Separator())
        foot = Gtk.Box(spacing=6, homogeneous=True)
        self.name_btn = Gtk.Button(label="Name…")
        self.name_btn.connect("clicked", self._closing(ind.on_name))
        self.dir_btn = Gtk.Button(label="Folder…")
        self.dir_btn.connect("clicked", self._closing(ind.on_dir))
        self.open_btn = Gtk.Button(label="Open folder")
        self.open_btn.connect("clicked", self._closing(ind.on_open_dir))
        for b in (self.name_btn, self.dir_btn, self.open_btn):
            foot.add(b)
        box.add(foot)
        self.setup_btn = Gtk.Button(label="Run omdrop setup")
        self.setup_btn.connect("clicked", self._closing(ind.on_setup))
        box.add(self.setup_btn)
        self.install_btn = Gtk.Button(label="How to install omdrop…")
        self.install_btn.connect("clicked", self._closing(lambda _w: open_uri(INSTALL_URL)))
        box.add(self.install_btn)
        frame.show_all()

    def _closing(self, handler, *args):
        # Dialogs and file choosers need the pointer this window holds.
        def run(_w):
            self.close()
            handler(None, *args)
        return run

    def _switched(self, switch, _pspec):
        if not self.ind.updating:
            self.ind.toggle_item.set_active(switch.get_active())

    def render(self, v):
        """Bring the window in line with the indicator's view of things."""
        ind = self.ind
        self.head.set_label(v.head)
        self.detail.set_label(v.detail)
        self.detail.set_visible(bool(v.detail))
        self.switch.set_active(v.receiving)
        self.switch.set_sensitive(v.controls and not ind.busy)
        self.dur_buttons[v.duration].set_active(True)
        self.vis_buttons["contacts" if v.contacts else "everyone"].set_active(True)
        for w in (self.dur_row, self.vis_row, self.name_btn, self.dir_btn):
            w.set_sensitive(v.controls)
        self.open_btn.set_sensitive(v.dir is not None)
        self.name_btn.set_tooltip_text(f"Apple devices see “{v.name}”" if v.name else None)
        self.dir_btn.set_tooltip_text(f"Saving to {tildify(v.dir)}" if v.dir else None)
        self.setup_btn.set_visible(v.installed and v.not_ready)
        self.install_btn.set_visible(not v.installed)
        self.render_peers(v.receiving and v.visible)

    def render_peers(self, visible):
        ind = self.ind
        shown = ind.peers if visible else {}
        for mac in [mac for mac in self.rows if mac not in shown]:
            self.rows.pop(mac)["row"].destroy()
        # Rows keep the order devices were first seen in, so one does not
        # jump away from the pointer when its signal reading changes.
        for mac, p in shown.items():
            r = self.rows.get(mac) or self._add_row(mac)
            r["name"].set_label(ind.peer_label(mac))
            rssi = p.get("rssi")
            r["rssi"].set_label(f"{rssi} dBm" if rssi is not None else "")
            sending = mac in ind.sends
            for w in (r["files"], r["link"]):
                w.set_visible(not sending)
            for w in (r["spinner"], r["cancel"]):
                w.set_visible(sending)
            r["spinner"].props.active = sending

        if not visible:
            hint = "Turn on AirDrop to find nearby devices."
        elif not shown:
            hint = "None yet. Open the AirDrop sheet on the other device."
        else:
            hint = ""
        self.hint.set_label(hint)
        self.hint.set_visible(bool(hint))
        self.lookup.set_visible(visible)
        self.lookup.set_label("Stop looking up names" if ind.lookup else "Look up device names")

    def _add_row(self, mac):
        ind = self.ind
        row = Gtk.Box(spacing=6)
        name = Gtk.Label(xalign=0, ellipsize=3)     # Pango.EllipsizeMode.END
        row.pack_start(name, True, True, 0)
        rssi = Gtk.Label()
        rssi.get_style_context().add_class("dim-label")
        row.pack_start(rssi, False, False, 0)
        files = Gtk.Button(label="Files…")
        files.connect("clicked", self._closing(ind.on_send_files, mac))
        link = Gtk.Button(label="Link…")
        link.connect("clicked", self._closing(ind.on_send_link, mac))
        spinner = Gtk.Spinner()
        cancel = Gtk.Button(label="Cancel")
        cancel.connect("clicked", ind.on_cancel_send, mac)
        for w in (files, link, spinner, cancel):
            row.pack_start(w, False, False, 0)
        row.show_all()
        self.list.add(row)
        r = self.rows[mac] = {"row": row, "name": name, "rssi": rssi, "files": files,
                              "link": link, "spinner": spinner, "cancel": cancel}
        return r

    # ----------------------------------------------------------- open, close

    def toggle(self, x, y):
        if self.win.get_visible():
            self.close()
        else:
            self.open(x, y)

    def open(self, x, y):
        self.anchor = (x, y)
        self.ind.render()
        if self.x11:
            self.place()
        self.win.show()
        self.win.present()
        if self.x11:
            self._grab(5)
        self.ind.refresh_status()

    def _grab(self, tries):
        # The tray may still hold the pointer from the click for a moment.
        seat = self.win.get_display().get_default_seat()
        status = seat.grab(self.win.get_window(), Gdk.SeatCapabilities.ALL, True,
                           None, None, None, None)
        if status == Gdk.GrabStatus.SUCCESS:
            self.seat = seat
            self.win.grab_add()
        elif tries > 0 and self.win.get_visible():
            GLib.timeout_add(50, lambda: self._grab(tries - 1))
        return False

    def close(self):
        if self.seat:
            self.seat.ungrab()
            self.seat = None
            self.win.grab_remove()
        self.win.hide()

    def _outside_click(self, win, event):
        alloc = win.get_allocation()
        if not (0 <= event.x < alloc.width and 0 <= event.y < alloc.height):
            self.close()
            return True
        return False

    def _key(self, win, event):
        if event.keyval == Gdk.KEY_Escape:
            self.close()
            return True
        return False

    def _resized(self, win, alloc):
        # Growing moves the window too when it hangs above a bottom panel, so
        # it keeps its edge against the panel; in an idle, after GTK's own
        # resize has gone through.
        if self.x11 and win.get_visible() and not self.place_id:
            self.place_id = GLib.idle_add(self._replace)

    def _replace(self):
        self.place_id = 0
        if self.win.get_visible():
            self.place()
        return False

    def place(self):
        """Put the window against the panel the click came from."""
        x, y = self.anchor
        display = self.win.get_display()
        monitor = display.get_monitor_at_point(x, y) or display.get_primary_monitor()
        wa = monitor.get_workarea()
        _, nat = self.win.get_preferred_size()
        w, h = nat.width, nat.height
        right, bottom = wa.x + wa.width, wa.y + wa.height
        if y >= bottom:                 # bottom panel: hang above it
            top = bottom - h
        elif y < wa.y:                  # top panel: hang below it
            top = wa.y
        else:                           # side panel, or one that reserves no space
            top = y - h if y > wa.y + wa.height // 2 else y
        if x >= right:
            left = right - w
        elif x < wa.x:
            left = wa.x
        else:
            left = x - w // 2
        left = max(wa.x, min(left, right - w))
        top = max(wa.y, min(top, bottom - h))
        self.win.move(left, top)


class Indicator:
    def __init__(self):
        self.cli = find_cli()
        self.settings = Settings()
        self.status = None          # last `omdrop status --json`
        self.status_at = 0          # monotonic seconds it was read at
        self.doctor = None          # last `omdrop doctor --json`
        self.busy = None            # "Turning on…" and the like, while a command runs
        self.peers = {}             # mac -> {"mac", "rssi", "name"}
        self.names = {}             # mac -> name, kept across listings this session
        self.lookup = None          # running `peers -n --stream`
        self.sends = {}             # mac -> running send Command
        self.status_cmd = None
        self.peers_cmd = None
        self.journal = None
        self.notes = set()          # notifications kept alive so their actions work
        self.updating = False       # set while syncing widgets to state, so handlers stay quiet
        self.poll_id = 0

        self.build_menu()
        self.popup = Popup(self)
        here = os.path.join(os.path.dirname(os.path.realpath(__file__)), "icons")
        # Left click opens the drop-down, right click the menu, and a middle
        # click toggles receiving, as it mutes in the volume applets.
        self.tray = TrayIcon(self.menu, here if os.path.isdir(here) else None,
                             self.popup.toggle,
                             lambda: self.toggle_item.set_active(
                                 not self.toggle_item.get_active()))

        if self.cli:
            self.refresh_status()
            self.refresh_doctor()
            self.follow_receiver()
        self.render()
        GLib.timeout_add_seconds(1, self.tick)

    # ------------------------------------------------------------------ menu

    def build_menu(self):
        m = self.menu = Gtk.Menu()

        self.header = Gtk.MenuItem(label="AirDrop")
        self.header.set_sensitive(False)
        m.append(self.header)
        self.detail = Gtk.MenuItem(label="")
        self.detail.set_sensitive(False)
        m.append(self.detail)

        self.toggle_item = Gtk.CheckMenuItem(label="Receive files")
        self.toggle_item.connect("toggled", self.on_toggle)
        m.append(self.toggle_item)

        self.dur_item = Gtk.MenuItem(label="Stay visible for")
        dur_menu = Gtk.Menu()
        self.dur_items = {}
        group = None
        for arg, label in DURATIONS:
            it = Gtk.RadioMenuItem.new_with_label_from_widget(group, label)
            group = it
            it.connect("toggled", self.on_duration, arg)
            dur_menu.append(it)
            self.dur_items[arg] = it
        self.dur_item.set_submenu(dur_menu)
        m.append(self.dur_item)

        self.vis_item = Gtk.MenuItem(label="Who can send")
        vis_menu = Gtk.Menu()
        self.vis_everyone = Gtk.RadioMenuItem.new_with_label_from_widget(None, "Everyone")
        self.vis_contacts = Gtk.RadioMenuItem.new_with_label_from_widget(
            self.vis_everyone, "Contacts only")
        self.vis_everyone.connect("toggled", self.on_visibility, "everyone")
        self.vis_contacts.connect("toggled", self.on_visibility, "contacts")
        vis_menu.append(self.vis_everyone)
        vis_menu.append(self.vis_contacts)
        self.vis_item.set_submenu(vis_menu)
        m.append(self.vis_item)

        m.append(Gtk.SeparatorMenuItem())

        # Nearby devices are listed only in the left-click drop-down: they
        # arrive while it is open, and an open GtkMenu cannot grow to fit them.
        self.send_item = Gtk.MenuItem(label="Send files: left-click the icon")
        self.send_item.set_sensitive(False)
        m.append(self.send_item)

        m.append(Gtk.SeparatorMenuItem())

        self.name_item = Gtk.MenuItem(label="Name…")
        self.name_item.connect("activate", self.on_name)
        m.append(self.name_item)
        self.dir_item = Gtk.MenuItem(label="Save files to…")
        self.dir_item.connect("activate", self.on_dir)
        m.append(self.dir_item)
        self.open_dir_item = Gtk.MenuItem(label="Open download folder")
        self.open_dir_item.connect("activate", self.on_open_dir)
        m.append(self.open_dir_item)

        self.setup_sep = Gtk.SeparatorMenuItem()
        m.append(self.setup_sep)
        self.setup_item = Gtk.MenuItem(label="Run omdrop setup")
        self.setup_item.connect("activate", self.on_setup)
        m.append(self.setup_item)
        self.install_item = Gtk.MenuItem(label="How to install omdrop…")
        self.install_item.connect("activate", lambda _i: open_uri(INSTALL_URL))
        m.append(self.install_item)

        m.append(Gtk.SeparatorMenuItem())
        quit_item = Gtk.MenuItem(label="Quit")
        quit_item.connect("activate", self.on_quit)
        m.append(quit_item)

        m.show_all()

    def render(self):
        """Bring every widget in line with the last status. Cheap; called often."""
        self.updating = True
        try:
            self._render()
        finally:
            self.updating = False

    def describe(self):
        """The header, status line and icon for the current state."""
        s = self.status
        receiving = bool(s and s.get("receiving"))
        not_ready = self.doctor is not None and not self.doctor.get("ready")
        if self.cli is None:
            return ("AirDrop: omdrop is not installed",
                    "owldrop needs the omdrop command.", "owldrop-indicator-alert")
        if self.busy:
            return (f"AirDrop: {self.busy}", "One moment…",
                    "owldrop-indicator-on" if receiving else "owldrop-indicator-off")
        if s is None:
            return "AirDrop", "Reading status…", "owldrop-indicator-off"
        if not receiving:
            if not_ready and self.doctor.get("missing"):
                return ("AirDrop: Off",
                        "Not ready: " + self.doctor["missing"][0].get("say", ""),
                        "owldrop-indicator-alert")
            return "AirDrop: Off", "Not visible to nearby devices.", "owldrop-indicator-off"
        if s.get("visible"):
            name = s.get("name") or "this computer"
            detail = self.window_text()
            if s.get("visibility") == "contacts":
                n = s.get("senders") or 0
                who = (f"{n} known sender{'s' if n != 1 else ''}" if n
                       else "nobody (no known senders)")
                detail = f"{detail} · contacts only: {who}"
            return f"Visible as \u201c{name}\u201d", detail, "owldrop-indicator-on"
        return ("Receiving, but not visible",
                s.get("reason") or "The radio is not advertising.", "owldrop-indicator-alert")

    def _render(self):
        s = self.status
        installed = self.cli is not None
        receiving = bool(s and s.get("receiving"))
        visible = bool(s and s.get("visible"))
        not_ready = self.doctor is not None and not self.doctor.get("ready")
        head, detail, icon = self.describe()

        # The menu's rows stay the same from state to state, so its height
        # does not change while it is open: an open GtkMenu cannot grow.
        self.header.set_label(head)
        self.detail.set_label(detail)
        self.tray.set(icon, head)

        controls = installed and s is not None
        self.toggle_item.set_sensitive(controls and not self.busy)
        self.toggle_item.set_active(receiving)

        want = self.settings.get("duration", "10m")
        if want not in self.dur_items:
            want = "10m"
        self.dur_items[want].set_active(True)
        self.dur_item.set_sensitive(controls)

        contacts = bool(s and s.get("visibility") == "contacts")
        self.vis_item.set_sensitive(controls)
        (self.vis_contacts if contacts else self.vis_everyone).set_active(True)

        name = (s or {}).get("name")
        self.name_item.set_label(f"Name: {name}…" if name else "Name…")
        self.name_item.set_sensitive(controls)
        d = (s or {}).get("dir")
        self.dir_item.set_label(f"Save files to: {tildify(d)}…" if d else "Save files to…")
        self.dir_item.set_sensitive(controls)
        self.open_dir_item.set_sensitive(bool(d))

        self.setup_sep.set_visible(not installed or not_ready)
        self.setup_item.set_visible(installed and not_ready)
        self.install_item.set_visible(not installed)

        self.popup.render(SimpleNamespace(
            head=head, detail=detail, installed=installed, controls=controls,
            receiving=receiving, visible=visible, not_ready=not_ready, duration=want,
            contacts=contacts, name=name, dir=d))

    def window_text(self):
        s = self.status
        mode = s.get("mode")
        rem = s.get("remaining")
        if rem is not None:
            left = rem - (GLib.get_monotonic_time() / 1e6 - self.status_at)
            return f"{clock(left)} left"
        if mode == "once":
            return "until one file arrives"
        return "until turned off"

    # ----------------------------------------------------------------- state

    def tick(self):
        # The countdown moves between polls; nothing else needs redrawing.
        s = self.status
        if s and s.get("receiving") and s.get("visible") and s.get("remaining") is not None \
                and not self.busy:
            self.updating = True
            try:
                _, detail, _ = self.describe()
                self.detail.set_label(detail)
                self.popup.detail.set_label(detail)
            finally:
                self.updating = False
        return True

    def schedule_poll(self):
        if self.poll_id:
            GLib.source_remove(self.poll_id)
        receiving = bool(self.status and self.status.get("receiving"))
        self.poll_id = GLib.timeout_add_seconds(
            POLL_ON_S if receiving else POLL_OFF_S, self._poll)

    def _poll(self):
        self.poll_id = 0
        self.refresh_status()
        return False

    def refresh_status(self):
        if self.status_cmd:
            return
        self.status_cmd = Command([self.cli, "status", "--json"], self._got_status)

    def _got_status(self, rc, out, err):
        self.status_cmd = None
        was_visible = bool(self.status and self.status.get("visible"))
        if rc == 0:
            try:
                self.status = json.loads(out)
                self.status_at = GLib.get_monotonic_time() / 1e6
            except ValueError:
                print(f"{APP_ID}: unreadable status: {out!r}", file=sys.stderr)
        else:
            print(f"{APP_ID}: omdrop status failed: {err.strip()}", file=sys.stderr)
        visible = bool(self.status and self.status.get("receiving") and self.status.get("visible"))
        if visible and not was_visible:
            self.refresh_peers()
        if not visible:
            self.peers = {}
            if self.lookup:
                self.lookup.stop()
        if not (self.status and self.status.get("receiving")) and self.doctor is None:
            self.refresh_doctor()
        self.render()
        self.schedule_poll()

    def refresh_doctor(self):
        Command([self.cli, "doctor", "--json"], self._got_doctor)

    def _got_doctor(self, rc, out, err):
        try:
            self.doctor = json.loads(out) if rc == 0 else None
        except ValueError:
            self.doctor = None
        self.render()

    def refresh_peers(self):
        """The passive listing: reads the radio's peer table, transmits nothing."""
        if self.peers_cmd is None and self.status and self.status.get("visible"):
            self.peers_cmd = Command([self.cli, "peers", "--json"], self._got_peers)
        return False

    def _got_peers(self, rc, out, err):
        self.peers_cmd = None
        if rc == 0:
            try:
                fresh = {p["mac"]: p for p in json.loads(out)}
            except (ValueError, KeyError, TypeError):
                fresh = None
            if fresh is not None and fresh != self.peers:
                self.peers = fresh
                self.render()
        if self.status and self.status.get("receiving") and self.status.get("visible"):
            GLib.timeout_add_seconds(PEERS_S, self.refresh_peers)

    # -------------------------------------------------------------- receiving

    def on_toggle(self, item):
        if self.updating:
            return
        if item.get_active():
            dur = self.settings.get("duration", "10m")
            self.run_busy("Turning on…", ["on", dur], "Could not turn AirDrop on")
        else:
            self.run_busy("Turning off…", ["off"], "Could not turn AirDrop off")

    def on_duration(self, item, arg):
        if self.updating or not item.get_active():
            return
        self.settings.set("duration", arg)
        # While on, re-arm the window with the new length, as the panel does.
        if self.status and self.status.get("receiving"):
            self.run_busy("Changing how long…", ["on", arg], "Could not change the window")

    def on_visibility(self, item, mode):
        if self.updating or not item.get_active():
            return
        self.run_quiet(["visibility", mode], "Could not change who can send")

    def run_busy(self, label, args, failure):
        self.busy = label
        self.render()

        def done(rc, out, err):
            self.busy = None
            if rc != 0:
                notify(failure, last_line(err) or last_line(out) or f"omdrop exited {rc}",
                       "dialog-warning")
            self.refresh_status()
            self.refresh_doctor()
        Command([self.cli] + args, done)

    def run_quiet(self, args, failure, success=None):
        def done(rc, out, err):
            if rc != 0:
                notify(failure, last_line(err) or last_line(out) or f"omdrop exited {rc}",
                       "dialog-warning")
            elif success:
                notify(success, last_line(out))
            self.refresh_status()
        Command([self.cli] + args, done)

    def on_name(self, _item):
        current = (self.status or {}).get("name") or ""
        new = ask_text("AirDrop name", "Apple devices will see this computer as:",
                       current, "Rename")
        if new is not None and new.strip() and new.strip() != current:
            self.run_quiet(["name", new.strip()], "Could not rename")

    def on_dir(self, _item):
        dlg = Gtk.FileChooserNative.new("Save received files to", None,
                                        Gtk.FileChooserAction.SELECT_FOLDER, "Select", "Cancel")
        d = (self.status or {}).get("dir")
        if d and os.path.isdir(d):
            dlg.set_current_folder(d)
        if dlg.run() == Gtk.ResponseType.ACCEPT:
            path = dlg.get_filename()
            if path:
                self.run_quiet(["dir", path], "Could not change the download folder")
        dlg.destroy()

    def on_open_dir(self, _item):
        d = (self.status or {}).get("dir")
        if d:
            open_uri(Gio.File.new_for_path(d).get_uri())

    def on_setup(self, _item):
        def done(rc, out, err):
            body = (out.strip() or err.strip())[-600:]
            notify("omdrop setup" if rc == 0 else "omdrop setup failed", body,
                   None if rc == 0 else "dialog-warning")
            self.refresh_doctor()
            self.refresh_status()
        Command([self.cli, "setup"], done)

    def follow_receiver(self):
        """Announce arrivals from the receiver's log, as `omdrop watch` does."""
        if not shutil.which("journalctl"):
            return
        self.journal = Command(
            ["journalctl", "--user", "-u", RECEIVER_UNIT, "-f", "-n", "0", "-o", "cat"],
            self._journal_ended, on_line=self._journal_line)

    def _journal_ended(self, rc, out, err):
        # journalctl should never end; if it does, try again shortly.
        self.journal = None
        GLib.timeout_add_seconds(5, lambda: (self.follow_receiver(), False)[1])

    def _journal_line(self, line):
        files = []
        if "upload " in line and ": stored " in line:
            files = line.split(": stored ", 1)[1].split(",")
        elif "link stored as " in line:
            files = [line.split("link stored as ", 1)[1].split(" -> ", 1)[0]]
        d = (self.status or {}).get("dir") or os.path.expanduser("~/Downloads")
        for f in (f.strip() for f in files):
            if not f:
                continue
            path = f if f.startswith("/") else os.path.join(d, f)
            if os.path.exists(path):
                self.announce(path)

    def announce(self, path):
        n = Notify.Notification.new(os.path.basename(path),
                                    f"Received over AirDrop, saved to {tildify(os.path.dirname(path))}/",
                                    "document-save")
        uri = Gio.File.new_for_path(path).get_uri()
        if "actions" in Notify.get_server_caps():
            n.add_action("default", "Open", lambda *_: open_uri(uri))
            n.add_action("open", "Open", lambda *_: open_uri(uri))
            n.add_action("show", "Show in folder", lambda *_: show_in_folder(path))
        keep(self.notes, n)

    # ---------------------------------------------------------------- sending

    def on_lookup(self, _item):
        if self.lookup:
            self.lookup.stop()
            return

        def line(text):
            try:
                p = json.loads(text)
            except ValueError:
                return
            mac = p.get("mac")
            if not mac:
                return
            if p.get("name"):
                self.names[mac] = p["name"]
            self.peers.setdefault(mac, p)
            self.render()

        def done(rc, out, err):
            self.lookup = None
            if rc not in (0, 1, -1, 143) and err.strip():
                notify("Could not look up names", last_line(err), "dialog-warning")
            self.render()
        self.lookup = Command([self.cli, "peers", "--json", "-n", "--stream"], done,
                              on_line=line)
        self.render()

    def peer_label(self, mac):
        return self.names.get(mac) or (self.peers.get(mac) or {}).get("name") or mac

    def on_send_files(self, _item, mac):
        dlg = Gtk.FileChooserNative.new(f"Send to {self.peer_label(mac)}", None,
                                        Gtk.FileChooserAction.OPEN, "Send", "Cancel")
        dlg.set_select_multiple(True)
        start = self.settings.get("send_from", "")
        if start and os.path.isdir(start):
            dlg.set_current_folder(start)
        files = []
        if dlg.run() == Gtk.ResponseType.ACCEPT:
            files = [f for f in dlg.get_filenames() if f]
        dlg.destroy()
        if files:
            self.settings.set("send_from", os.path.dirname(files[0]))
            what = os.path.basename(files[0]) if len(files) == 1 else f"{len(files)} files"
            self.send(mac, files, what)

    def on_send_link(self, _item, mac):
        url = ask_text("Send a link", f"Link to send to {self.peer_label(mac)}:", "", "Send")
        if url and url.strip():
            url = url.strip()
            if not url.startswith(("http://", "https://")):
                notify("Not sent", "Only http and https links can be sent.", "dialog-warning")
                return
            self.send(mac, [url], url)

    def send(self, mac, items, what):
        who = self.peer_label(mac)

        def done(rc, out, err):
            self.sends.pop(mac, None)
            if rc == 0:
                notify(f"Sent to {who}", what, "document-send")
            elif rc in (-1, 143, 130):
                notify("Send cancelled", f"{what} to {who}")
            else:
                notify(f"Could not send to {who}",
                       last_line(err) or last_line(out) or f"omdrop exited {rc}",
                       "dialog-warning")
            self.render()
        self.sends[mac] = Command([self.cli, "send", "--to", mac, "--"] + items, done)
        self.render()

    def on_cancel_send(self, _item, mac):
        cmd = self.sends.get(mac)
        if cmd:
            cmd.stop()

    def on_quit(self, _item):
        if self.lookup:
            self.lookup.stop()
        if self.journal:
            self.journal.stop()
        Gtk.main_quit()


# ------------------------------------------------------------------ helpers

def keep(store, n):
    """Show a notification and hold a reference until it closes, or its
    actions are collected before anyone can click them."""
    store.add(n)
    n.connect("closed", lambda n: store.discard(n))
    try:
        n.show()
    except GLib.Error as e:
        store.discard(n)
        print(f"{APP_ID}: notification failed: {e.message}", file=sys.stderr)


_NOTES = set()


def notify(summary, body="", icon=None):
    keep(_NOTES, Notify.Notification.new(summary, body, icon or "document-send"))


def open_uri(uri):
    try:
        Gio.AppInfo.launch_default_for_uri(uri, None)
    except GLib.Error as e:
        notify("Could not open", e.message, "dialog-warning")


def show_in_folder(path):
    """Select the file in the file manager, or at least open its folder."""
    uri = Gio.File.new_for_path(path).get_uri()
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        bus.call_sync("org.freedesktop.FileManager1", "/org/freedesktop/FileManager1",
                      "org.freedesktop.FileManager1", "ShowItems",
                      GLib.Variant("(ass)", ([uri], "")), None,
                      Gio.DBusCallFlags.NONE, 2000, None)
    except GLib.Error:
        open_uri(Gio.File.new_for_path(os.path.dirname(path)).get_uri())


def ask_text(title, prompt, initial, accept):
    """A one-line text dialog. Returns the text, or None when cancelled."""
    dlg = Gtk.Dialog(title=title, flags=Gtk.DialogFlags.MODAL)
    dlg.add_buttons("Cancel", Gtk.ResponseType.CANCEL, accept, Gtk.ResponseType.OK)
    dlg.set_default_response(Gtk.ResponseType.OK)
    dlg.set_icon_name("owldrop-indicator-on")
    box = dlg.get_content_area()
    box.set_spacing(8)
    box.set_border_width(12)
    box.add(Gtk.Label(label=prompt, xalign=0))
    entry = Gtk.Entry(text=initial, activates_default=True, width_chars=36)
    box.add(entry)
    dlg.show_all()
    dlg.set_keep_above(True)
    dlg.present()
    text = entry.get_text() if dlg.run() == Gtk.ResponseType.OK else None
    dlg.destroy()
    return text


def main():
    if "--version" in sys.argv[1:]:
        print(f"{APP_ID} 0.1.0")
        return 0
    GLib.set_prgname(APP_ID)
    GLib.set_application_name("Owldrop")
    Notify.init("Owldrop")
    # One indicator per session: a second copy would put a second icon in the tray.
    app = Gio.Application(application_id="io.github.owldrop.Indicator",
                          flags=Gio.ApplicationFlags.FLAGS_NONE)
    try:
        app.register(None)
    except GLib.Error:
        pass
    if app.get_is_remote():
        print(f"{APP_ID}: already running", file=sys.stderr)
        return 0
    try:
        gi.require_version("GLibUnix", "2.0")
        from gi.repository import GLibUnix
        signal_add = GLibUnix.signal_add
    except (ValueError, ImportError):
        signal_add = GLib.unix_signal_add
    signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT, Gtk.main_quit)
    signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, Gtk.main_quit)
    Indicator()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
