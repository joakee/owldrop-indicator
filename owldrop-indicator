RECEIVER_UNIT = "airdrop-receiver.service"
INSTALL_URL = "https://github.com/t4t5/omdrop-plugin"

# What "Stay visible for" offers, as `omdrop on` spells each one.
DURATIONS = [
    ("once", "Until one file arrives"),
    ("10m", "10 minutes"),
    ("30m", "30 minutes"),
    ("1h", "1 hour"),
    ("forever", "Until turned off"),
]

DURATION_SHORT = {"once": "Once", "10m": "10 min", "30m": "30 min", "1h": "1 hr",
                  "forever": "Always"}

POLL_ON_S = 2     # status while receiving: the countdown and visibility move
POLL_OFF_S = 10    # status while off: only someone else turning it on changes it
PEERS_S = 5        # passive peer listing while visible; transmits nothing

CONFIG_DIR = os.path.join(GLib.get_user_config_dir(), APP_ID)
CONFIG_FILE = os.path.join(CONFIG_DIR, "settings.ini")


def find_cli():
    """The omdrop command: $OWLDROP_CLI, else PATH, else where `omdrop setup` links it."""
    for cand in (os.environ.get("OWLDROP_CLI"), shutil.which("omdrop"),
                 os.path.expanduser("~/.local/bin/omdrop")):
        if cand and os.access(cand, os.X_OK):
            return cand
    return None


def tildify(path):
    home = os.path.expanduser("~")
    return "~" + path[len(home):] if path == home or path.startswith(home + "/") else path


def clock(secs):
    secs = max(0, int(secs))
    h, rem = divmod(secs, 3600)
    m, s = divmod(rem, 60)
    return f"{h}:{m:02d}:{s:02d}" if h else f"{m}:{s:02d}"


def last_line(text):
    """The sentence worth showing from a failed command's stderr."""
    lines = [ln.strip() for ln in text.strip().splitlines() if ln.strip()]
    if not lines:
        return ""
    msg = lines[-1]
    return msg[len("omdrop: "):] if msg.startswith("omdrop: ") else msg


class Settings:
    """The indicator's own preferences; omdrop keeps everything else."""

    def __init__(self):
        self.kf = GLib.KeyFile()
        try:
            self.kf.load_from_file(CONFIG_FILE, GLib.KeyFileFlags.NONE)
        except GLib.Error:
            pass

    def get(self, key, default):
        try:
            return self.kf.get_string("indicator", key)
        except GLib.Error:
            return default

    def set(self, key, value):
        self.kf.set_string("indicator", key, value)
        try:
            os.makedirs(CONFIG_DIR, exist_ok=True)
            self.kf.save_to_file(CONFIG_FILE)
        except (OSError, GLib.Error) as e:
            print(f"{APP_ID}: could not save settings: {e}", file=sys.stderr)


class Command:
    """One run of omdrop (or anything else), asynchronous, never blocking the menu."""

    def __init__(self, argv, done=None, on_line=None):
        self.done = done
        self.proc = None
        flags = Gio.SubprocessFlags.STDOUT_PIPE | Gio.SubprocessFlags.STDERR_PIPE
        try:
            self.proc = Gio.Subprocess.new(argv, flags)
        except GLib.Error as e:
            GLib.idle_add(self._finish, 127, "", e.message)
            return
        if on_line is None:
            self.proc.communicate_utf8_async(None, None, self._communicated)
        else:
            # Streamed: each stdout line as it arrives, stderr collected for the end.
            self.on_line = on_line
            self.err = []
            self.out = Gio.DataInputStream.new(self.proc.get_stdout_pipe())
            self.errs = Gio.DataInputStream.new(self.proc.get_stderr_pipe())
            self.out.read_line_async(GLib.PRIORITY_DEFAULT, None, self._got_line)
            self.errs.read_line_async(GLib.PRIORITY_DEFAULT, None, self._got_err)

    def _got_line(self, stream, res):
        try:
            line, _ = stream.read_line_finish_utf8(res)
        except GLib.Error:
            line = None
        if line is None:
            self.proc.wait_async(None, self._waited)
            return
        self.on_line(line)
        stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self._got_line)

    def _got_err(self, stream, res):
        try:
            line, _ = stream.read_line_finish_utf8(res)
        except GLib.Error:
            line = None
        if line is not None:
            self.err.append(line)
            stream.read_line_async(GLib.PRIORITY_DEFAULT, None, self._got_err)

    def _waited(self, proc, res):
        try:
            proc.wait_finish(res)
        except GLib.Error:
            pass
        self._finish(self._status(), "", "\n".join(self.err))

    def _communicated(self, proc, res):
        try:
            _, out, err = proc.communicate_utf8_finish(res)
        except GLib.Error as e:
            out, err = "", e.message
        self._finish(self._status(), out or "", err or "")

    def _status(self):
        if self.proc.get_if_exited():
            return self.proc.get_exit_status()
        return -1

    def _finish(self, rc, out, err):
        if self.done:
            self.done(rc, out, err)
        return False

    def stop(self):
        # omdrop runs lookups and sends in their own process group and stops
        # them on TERM, so the sender and its Bluetooth advert go with it.
        if self.proc:
            self.proc.send_signal(signal.SIGTERM)


